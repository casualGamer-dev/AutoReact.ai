# Copy to .env - Expo inlines EXPO_PUBLIC_* vars at build time.
# Point this at your Oracle VM's Caddy-fronted API (server/), or a LAN IP
# (e.g. http://192.168.1.56:3000) for local device testing - Android needs
# android.usesCleartextTraffic: true in app.json for plain http:// to work.
EXPO_PUBLIC_API_URL=https://your-domain.example.com
